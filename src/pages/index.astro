---
import { render } from 'astro:content';
import HeroSection from '../components/HeroSection.astro';
import PageSection from '../components/PageSection.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import Timeline from '../components/Timeline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getExperience, getFeaturedProjects, getProfile, getSkills } from '../lib/content';

const profile = await getProfile();
const { Content: About } = await render(profile);
const skills = await getSkills();
const work = await getExperience('work');
const education = await getExperience('education');
const featured = await getFeaturedProjects();
---

<BaseLayout>
  <HeroSection profile={profile.data} />

  <PageSection id="sobre-mi" title="Sobre mí">
    <div class="prose">
      <About />
    </div>
  </PageSection>

  <PageSection id="habilidades" title="Habilidades">
    <SkillsGrid skills={skills} />
  </PageSection>

  <PageSection id="trayectoria" title="Trayectoria">
    <div class="timelines">
      {work.length > 0 && <Timeline title="Experiencia" items={work} />}
      {education.length > 0 && <Timeline title="Formación" items={education} />}
    </div>
  </PageSection>

  <PageSection id="proyectos-destacados" title="Proyectos destacados">
    <ProjectGrid projects={featured} />
    <p class="more">
      <a href="/proyectos">Ver todos los proyectos</a>
    </p>
  </PageSection>
</BaseLayout>

<style>
  .timelines {
    display: grid;
    gap: 2.5rem;
  }

  .more {
    margin-top: 1.5rem;
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .timelines {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
