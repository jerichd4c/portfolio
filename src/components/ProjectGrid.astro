---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  headingLevel?: 2 | 3;
  // Load the first card's image right away when the grid is at the top of the page
  eagerFirst?: boolean;
}

const { projects, headingLevel = 3, eagerFirst = false } = Astro.props;
---

{projects.length > 0 ? (
  <ul class="project-grid">
    {projects.map((project, index) => (
      <li>
        <ProjectCard
          project={project}
          headingLevel={headingLevel}
          eager={eagerFirst && index === 0}
        />
      </li>
    ))}
  </ul>
) : (
  <p>Todavía no hay proyectos publicados.</p>
)}

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .project-grid > li {
    display: flex;
  }

  .project-grid > li > :global(*) {
    flex: 1;
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
