---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod } from '../lib/format';

interface Props {
  title: string;
  items: CollectionEntry<'experience'>[];
}

const { title, items } = Astro.props;
---

<div class="timeline-group">
  <h3>{title}</h3>
  <ol class="timeline">
    {items.map(({ data }) => (
      <li class="timeline-item">
        <p class="period">{formatPeriod(data.start, data.end)}</p>
        <h4>{data.title}</h4>
        <p class="organization">
          {data.organization}
          {data.location && ` · ${data.location}`}
        </p>
        {data.description && <p>{data.description}</p>}
        {data.highlights.length > 0 && (
          <ul class="highlights">
            {data.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  h3 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }

  .timeline {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    border-left: 2px solid var(--border);
    list-style: none;
  }

  .timeline-item {
    position: relative;
    padding-left: 1.5rem;
  }

  /* Dot on the vertical line */
  .timeline-item::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: -0.4375rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .period {
    color: var(--muted);
    font-size: 0.875rem;
  }

  h4 {
    font-size: 1.0625rem;
  }

  .organization {
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-weight: 500;
  }

  .highlights {
    display: grid;
    gap: 0.375rem;
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }
</style>
