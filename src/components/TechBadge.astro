---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<li class="badge">{label}</li>

<style>
  .badge {
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
</style>
