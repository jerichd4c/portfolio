---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="page-section container" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  .page-section {
    padding-block: 2.5rem;
    scroll-margin-top: 5rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    font-size: 1.625rem;
  }
</style>
