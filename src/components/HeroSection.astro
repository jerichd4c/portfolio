---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getInitials } from '../lib/format';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  {profile.avatar ? (
    <Image
      class="avatar"
      src={profile.avatar}
      alt={profile.avatarAlt ?? ''}
      width={160}
      height={160}
      loading="eager"
    />
  ) : (
    <div class="avatar monogram" aria-hidden="true">
      {getInitials(profile.name)}
    </div>
  )}

  <div class="hero-text">
    <h1 id="hero-title">{profile.name}</h1>
    <p class="role">{profile.role}</p>
    <p class="tagline">{profile.tagline}</p>
    {profile.location && <p class="location">{profile.location}</p>}

    <div class="actions">
      <a class="button primary" href="/proyectos">
        Ver proyectos
      </a>
      <a class="button" href="/contacto">
        Contacto
      </a>
      {profile.cv && (
        <a class="button" href={profile.cv} download>
          Descargar CV <span class="sr-only">(PDF)</span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding-block: 3rem;
    text-align: center;
  }

  .avatar {
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .monogram {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--bg);
    font-size: 2.75rem;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.15;
  }

  .role {
    color: var(--accent);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .tagline,
  .location {
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .button {
    padding: 0.625rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover {
    background: var(--surface);
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .button.primary:hover {
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: auto 1fr;
      justify-items: start;
      gap: 2.5rem;
      padding-block: 4rem;
      text-align: left;
    }

    .avatar {
      width: 10rem;
      height: 10rem;
    }

    .actions {
      justify-content: flex-start;
    }
  }
</style>
