---
import '../styles/global.css';
import AppFooter from '../components/AppFooter.astro';
import AppHeader from '../components/AppHeader.astro';
import { getProfile } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const profile = await getProfile();
const { name, role, seoDescription } = profile.data;

// Home page uses "Name · Role"; inner pages use "Page | Name"
const pageTitle = title ? `${title} | ${name}` : `${name} · ${role}`;
const pageDescription = description ?? seoDescription;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <AppHeader name={name} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <AppFooter profile={profile.data} />
  </body>
</html>
